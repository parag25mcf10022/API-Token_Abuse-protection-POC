# Copy to .env (git-ignored) and fill in. Real environment variables win.

# --- Email (Resend) ---
# A send-only API key from https://resend.com/api-keys. Leave empty to print
# emails to the server console instead of sending them.
RESEND_API_KEY=
# onboarding@resend.dev only delivers to your own Resend account's address;
# verify a domain in Resend to email anyone.
EMAIL_FROM='"AAP" <onboarding@resend.dev>'
# Public URL used in email links.
APP_URL=http://localhost:3000

# --- Sign in with Google / GitHub / Microsoft (optional) ---
# Redirect URI to register: <APP_URL>/auth/oauth/<google|github|microsoft>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (any Microsoft account) | organizations | consumers | <tenant id>
MICROSOFT_TENANT=common
